      if (mounted) {
        ScaffoldMessenger.of(
          context,
        ).showSnackBar(const SnackBar(content: Text('保存する会話がありません')));
      }
      return;
    }

    try {
      await ref
          .read(aiChatNotifierProvider.notifier)
          .saveCurrentChatToHistory(isManualSave: true);
      if (mounted) {
        ScaffoldMessenger.of(
          context,
