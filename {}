                                PetInfoCard(
                                  title: '体重・サイズ',
                                  value:
                                      registrationState.petWeight != null &&
                                          registrationState.petSize != null
                                      ? '${registrationState.petWeight!.toStringAsFixed(1)}kg・${registrationState.petSize}'
