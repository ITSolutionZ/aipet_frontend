            );
          },
        ),
        titlesData: _buildTitlesData(),
        borderData: _buildBorderData(),
        minX: 0,
        maxX: 6,
        minY: 0,
        maxY: 350,
        lineBarsData: [
          _buildActualDataLine(chartData),
