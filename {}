    final endOfMonth = DateTime(now.year, now.month + 1, 0);

    return call(petId: petId, startDate: startOfMonth, endDate: endOfMonth);
  }

  /// 지난 N일간 산책 통계 조회
  Future<WalkStatistics> getLastNDaysStatistics(
    int days, {
    String? petId,
  }) async {
