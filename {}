      onPressed: onStartLearning,
      icon: Icon(
        isLearning ? Icons.play_circle_fill : Icons.play_circle_outline,
        color: AppColors.pointBlue,
        size: 28,
      ),
      tooltip: isLearning ? '学習を継続' : '学習を開始',
    );
