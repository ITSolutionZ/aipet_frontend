class PetProfileEntity with _$PetProfileEntity {
  const factory PetProfileEntity({
    required String id,
    required String name,
    required String type, // 'dog', 'cat', 'bird', 'hamster', 'rabbit', 'turtle'
    String? breed,
    required DateTime birthDate,
