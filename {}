  final WalkRepository repository;

  EndWalkUseCase(this.repository);

  Future<WalkRecordEntity> call(
    String recordId, {
    double? distance,
    String? notes,
  }) async {
    // 비즈니스 로직: 산책 종료 전 유효성 검증
    if (recordId.isEmpty) {
      throw ArgumentError('산책 기록 ID는 필수입니다.');
    }

    // 산책 기록이 존재하는지 확인
