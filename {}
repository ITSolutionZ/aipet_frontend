  /// 교환 버튼
  Widget _buildExchangeButton(
    BuildContext context,
    WidgetRef ref,
    TokenExchangeState state,
  ) {
    return ElevatedButton(
      onPressed: state.isLoading
          ? null
          : () async {
              // Changed: async 추가
              await ref
                  .read(authControllerProvider.notifier)
                  .exchangeServerToken();

              // Changed: 성공/실패 토스트 표시
              if (context.mounted) {
