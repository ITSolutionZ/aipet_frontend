                                );
                              } else {
                                // 강아지나 고양이가 아닌 경우 이름 입력으로 바로 이동
                                context.go(RouteConstants.petNameInputRoute);
                              }
                            }
                          : null,
                    );
                  },
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }
}
