    if (walkRecord == null) {
      throw ArgumentError('산책 기록을 찾을 수 없습니다.');
    }

    // 산책이 진행 중인지 확인
    if (walkRecord.status != WalkStatus.inProgress) {
      throw StateError('진행 중인 산책만 종료할 수 있습니다.');
    }

    return repository.endWalk(recordId, distance: distance, notes: notes);
  }
}
