  String get formattedDistance {
    if (distance == null) return '距離情報がありません';
    if (distance! < 1) {
      return '${(distance! * 1000).round()}m';
    } else {
      return '${distance!.toStringAsFixed(1)}km';
    }
  }

  /// 평점 포맷팅
  String get formattedRating {
    return rating.toStringAsFixed(1);
  }

