# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # Runnerターゲットの設定を更新
  installer.generated_projects.each do |project|
    project.targets.each do |target|
      if target.name == 'Runner'
        target.build_configurations.each do |config|
          # ブリッジングヘッダーとモジュールインターフェースの競合を解決
          config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'NO'
          config.build_settings['SWIFT_EMIT_MODULE_INTERFACE'] = 'NO'
          config.build_settings['DEFINES_MODULE'] = 'YES'

          # ビルド時間最適化設定
          if config.name == 'Debug'
            # Debugモードでのビルド最適化
            config.build_settings['COMPILER_INDEX_STORE_ENABLE'] = 'NO' # インデックスストアを無効化（ビルド時間短縮）
            config.build_settings['SWIFT_COMPILATION_MODE'] = 'singlefile' # シングルファイルコンパイル（高速化）
            config.build_settings['SWIFT_OPTIMIZATION_LEVEL'] = '-Onone' # 最適化無効（ビルド時間短縮）
            config.build_settings['GCC_OPTIMIZATION_LEVEL'] = '0' # 最適化無効
            config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES' # アクティブアーキテクチャのみビルド
            config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO' # スクリプトサンドボックス無効化
            config.build_settings['SWIFT_ACTIVE_COMPILATION_CONDITIONS'] = '$(inherited) DEBUG'
            # 不要な警告を無効化（ビルド時間短縮）
            config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
            config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
            config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
          end
        end
      end
    end
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['ENABLE_BITCODE'] = 'NO'

      # ブリッジングヘッダーとモジュールインターフェースの競合を解決
      config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'NO'
      config.build_settings['SWIFT_EMIT_MODULE_INTERFACE'] = 'NO'
      config.build_settings['DEFINES_MODULE'] = 'YES'

      # Swift言語バージョンは自動設定に任せる
      # config.build_settings['SWIFT_VERSION'] = '5.0'

      # ビルド時間最適化設定（全ターゲットに適用）
      if config.name == 'Debug'
        # Debugモードでのビルド最適化
        config.build_settings['COMPILER_INDEX_STORE_ENABLE'] = 'NO' # インデックスストアを無効化（ビルド時間短縮）
        config.build_settings['SWIFT_COMPILATION_MODE'] = 'singlefile' # シングルファイルコンパイル（高速化）
        config.build_settings['SWIFT_OPTIMIZATION_LEVEL'] = '-Onone' # 最適化無効（ビルド時間短縮）
        config.build_settings['GCC_OPTIMIZATION_LEVEL'] = '0' # 最適化無効
        config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES' # アクティブアーキテクチャのみビルド
        config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO' # スクリプトサンドボックス無効化
        config.build_settings['SWIFT_ACTIVE_COMPILATION_CONDITIONS'] = '$(inherited) DEBUG'
        # 不要な警告を無効化（ビルド時間短縮）
        config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
        config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
        config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
        # 並列ビルド最適化
        config.build_settings['SWIFT_EMIT_MODULE_INTERFACE'] = 'NO'
        config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'NO'
      end

      # Firebase関連のターゲットに対して追加の設定
      if target.name.start_with?('Firebase')
        # Swift 6の実験的機能を無効化し、後方互換性を確保
        config.build_settings['OTHER_SWIFT_FLAGS'] = '$(inherited) -no-verify-emitted-module-interface'
        # 厳格な並行性チェックを無効化
        config.build_settings['SWIFT_STRICT_CONCURRENCY'] = 'complete'
      end

      # Google Maps 関連設定
      if target.name == 'GoogleMaps'
        config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
      end

      # Google Sign In 関連の設定（ブリッジングヘッダー問題対策）
      if target.name.include?('Google')
        config.build_settings['SWIFT_OBJC_BRIDGING_HEADER'] = ''
      end

      # Sentry Flutter 関連設定（nullability タイプ指定子エラー対策）
      if target.name.include?('sentry') || target.name.include?('Sentry')
        # nullability タイプ指定子の警告を無効化
        config.build_settings['CLANG_WARN_NULLABILITY'] = 'NO'
        config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
        # Objective-C nullability チェックを緩和
        config.build_settings['GCC_WARN_64_TO_32_BIT_CONVERSION'] = 'NO'
        # 互換性のための追加設定
        config.build_settings['CLANG_ANALYZER_NONNULL'] = 'NO'
      end

      # app_tracking_transparency ヘッダーサーチパス設定
      if target.name == 'Runner'
        config.build_settings['HEADER_SEARCH_PATHS'] = '$(inherited) $(PODS_ROOT)/app_tracking_transparency'
        # モジュール検索パス設定
        config.build_settings['MODULEMAP_FILE'] = ''
      end
    end
  end
end
